{
  "name": "faymio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --import tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "format": "prettier --write src tests prisma scripts *.ts *.mjs *.json *.md",
    "demo": "node scripts/demo.mjs",
    "test:launcher": "node --test tests/demo-launcher.test.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test:deployment": "node --test tests/vercel-build.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.9",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.9",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
